# Linux/Docker configuration. On Windows copy .env.windows.example instead.
# Runtime inference is local; external AI APIs are not used.
PORT=3000
HOST=127.0.0.1
ASR_PYTHON=python3
ASR_SCRIPT=scripts/transcribe_local.py
ASR_TIMEOUT_MS=900000
MAX_AUDIO_MB=100
MAX_AUDIO_DURATION_SECONDS=14400
MAX_CONCURRENT_ASR_JOBS=1

# Complete local faster-whisper/CTranslate2 model directory.
WHISPER_MODEL=/models/faster-whisper-large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Actual local pyannote pipeline config.yaml. All referenced weights must be local.
DIARIZATION_MODEL=/models/pyannote-speaker-diarization-3.1/config.yaml
# Keep false in a closed contour. true permits repository access for model downloads.
ALLOW_MODEL_DOWNLOAD=false
# Needed only for an explicitly permitted initial download, not offline inference.
# HUGGINGFACE_TOKEN=
