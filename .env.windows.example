# Windows host configuration.
# START_WINDOWS.cmd copies this file to .env on the first launch.
# The UI, text import and export work even when Python/models are not installed.
PORT=3000
HOST=127.0.0.1
ASR_PYTHON=.venv/Scripts/python.exe
ASR_SCRIPT=scripts/transcribe_local.py
ASR_TIMEOUT_MS=900000
MAX_AUDIO_MB=100
MAX_AUDIO_DURATION_SECONDS=14400
MAX_CONCURRENT_ASR_JOBS=1

# Required only for real audio processing. Use forward slashes in Windows paths.
# WHISPER_MODEL must be a complete local faster-whisper/CTranslate2 model directory.
WHISPER_MODEL=./models/faster-whisper-large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Point to the actual local pyannote pipeline config.yaml file. The snapshot and
# every model referenced by this config must also be available locally.
DIARIZATION_MODEL=./models/pyannote-speaker-diarization-3.1/config.yaml

# Keep false in a closed contour. When true, model repositories may be contacted.
ALLOW_MODEL_DOWNLOAD=false
# HUGGINGFACE_TOKEN is only for an explicitly permitted initial download.
# HUGGINGFACE_TOKEN=
