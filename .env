# Все модели работают локально; внешние AI API не используются.
PORT=3000
ASR_PYTHON=python3
ASR_SCRIPT=scripts/transcribe_local.py
ASR_TIMEOUT_MS=900000
MAX_AUDIO_MB=100

# Имя или локальный путь к модели faster-whisper.
# Для полностью офлайн-запуска укажите каталог с заранее загруженной моделью.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Обязателен для диаризации: локальный каталог модели pyannote.
DIARIZATION_MODEL=/models/pyannote-speaker-diarization-3.1
# HUGGINGFACE_TOKEN нужен только при первичной загрузке модели, не при offline-инференсе.
# HUGGINGFACE_TOKEN=
